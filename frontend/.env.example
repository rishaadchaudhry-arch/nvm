# Copy to frontend/.env and fill in.
#
# Where the app finds the backend. It must be an absolute URL, because the same
# bundle runs on a phone, where "localhost" would mean the phone itself.
#
# Web preview on the same machine:
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
#
# Expo Go on a phone: use your computer's LAN address (run `ipconfig getifaddr en0`
# on macOS, `hostname -I` on Linux, `ipconfig` on Windows):
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.20:8001
#
# Deployed backend:
# EXPO_PUBLIC_BACKEND_URL=https://api.yourdomain.com
