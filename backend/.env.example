# Copy to backend/.env and fill in. Never commit the filled-in file.

# --- Database ---
# Local MongoDB:
MONGO_URL=mongodb://localhost:27017
# MongoDB Atlas instead (free tier is enough to start):
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=nvm

# --- OpenAI (history text + narration) ---
# From https://platform.openai.com/api-keys — the account needs credit.
OPENAI_API_KEY=sk-...
# Optional overrides; these are the defaults the code uses.
# OPENAI_TEXT_MODEL=gpt-6-sol
# OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini

# --- Admin login for the app's admin screen ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-random-password

# Signs admin and device tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me

# --- Coverage area ---
# The app covers Delhi NCT only: searches are confined to it, and a point outside it is refused.
# Clear SCOPE_BBOX to cover all of India, or set your own "minLng,minLat,maxLng,maxLat".
SCOPE_NAME=Delhi
SCOPE_BBOX=76.8382,28.4041,77.3485,28.8835

# --- Tuning (optional; these are the defaults) ---
# Community upvotes needed before a story is shown as verified.
UPVOTE_THRESHOLD=5
# How many proxies of yours sit in front of the backend. 0 when you run it directly.
# Set it wrong and rate limits can be bypassed by a forged X-Forwarded-For header.
TRUSTED_PROXY_HOPS=0
# New histories one IP may build per hour.
BUILDS_PER_IP_PER_HOUR=40
